  <Scene>
    <WorldInfo title="Two Moving Waves Make Still Nodes" info="&quot;X3D Math Lab • Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.&quot;">
      <MetadataString containerField="metadata" name="mathlab.sample" reference="mathlab.x3d/1" value="&quot;{\&quot;adapter\&quot;:\&quot;mathlab.x3d/1\&quot;,\&quot;axes\&quot;:\&quot;Horizontal: x−3 for string position x∈[0,6]. Wave lanes offset vertically ±2.7; middle is the sum. Time is t/T.\&quot;,\&quot;bounds\&quot;:{\&quot;center\&quot;:[0.0,0.0,0.0325],\&quot;size\&quot;:[6.743,8.206,1.145]},\&quot;configuration_sha256\&quot;:\&quot;c2dd4c97774b9529bcec9377c7cae83c0c547987d181d7d37efd90e35420d9df\&quot;,\&quot;insights\&quot;:[\&quot;All lanes share the same horizontal coordinate x−3. Upper and lower displays are translated by y=±2.7 and z=∓0.25; those are viewing offsets, not physical displacements.\&quot;,\&quot;A node remains zero for every time. At a quarter period all displacements are zero only instantaneously, and the non-node points generally have nonzero transverse velocity.\&quot;,\&quot;Wave speed c controls phase propagation. A material point moves transversely and its speed is not c. The time slider uses t/T, so changing c at a frozen slider position preserves shape but changes period and physical time.\&quot;,\&quot;Energy shares assume the ideal linear, undamped, small-slope string with uniform mass density and tension. The geometry is a conceptual amplitude display, not a nonlinear string solver.\&quot;],\&quot;lesson\&quot;:\&quot;waves\&quot;,\&quot;metrics\&quot;:[{\&quot;id\&quot;:\&quot;nodes\&quot;,\&quot;label\&quot;:\&quot;Permanent nodes including endpoints\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;\&quot;,\&quot;value\&quot;:4},{\&quot;id\&quot;:\&quot;period\&quot;,\&quot;label\&quot;:\&quot;Physical period T\&quot;,\&quot;note\&quot;:\&quot;String length L=6. T=2L/(nc).\&quot;,\&quot;unit\&quot;:\&quot;s\&quot;,\&quot;value\&quot;:4.0},{\&quot;id\&quot;:\&quot;time_seconds\&quot;,\&quot;label\&quot;:\&quot;Physical time represented\&quot;,\&quot;note\&quot;:\&quot;The time control is a fraction of one current period; changing c changes physical time at the same frozen phase.\&quot;,\&quot;unit\&quot;:\&quot;s\&quot;,\&quot;value\&quot;:0.48},{\&quot;id\&quot;:\&quot;kinetic\&quot;,\&quot;label\&quot;:\&quot;Whole-string kinetic energy share\&quot;,\&quot;note\&quot;:\&quot;Ideal undamped linear string; normalized integral over the whole string.\&quot;,\&quot;unit\&quot;:\&quot;of total\&quot;,\&quot;value\&quot;:0.4686047402353432},{\&quot;id\&quot;:\&quot;potential\&quot;,\&quot;label\&quot;:\&quot;Whole-string elastic energy share\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;of total\&quot;,\&quot;value\&quot;:0.5313952597646567},{\&quot;id\&quot;:\&quot;sum_residual\&quot;,\&quot;label\&quot;:\&quot;Sum / standing-form max difference\&quot;,\&quot;note\&quot;:\&quot;Sampled floating-point check of the sine addition identity.\&quot;,\&quot;unit\&quot;:\&quot;\&quot;,\&quot;value\&quot;:5.551115123125783e-16}],\&quot;parameters\&quot;:{\&quot;amplitude\&quot;:0.65,\&quot;mode\&quot;:3,\&quot;probe\&quot;:0.37,\&quot;speed\&quot;:1,\&quot;time\&quot;:0.12},\&quot;sample_schema\&quot;:\&quot;mathlab.sample/1\&quot;,\&quot;sample_sha256\&quot;:\&quot;6f37856adf22c31b55603318d6587925ba23ce3fda7e30647323912f15862f9b\&quot;,\&quot;scope\&quot;:\&quot;Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.\&quot;,\&quot;title\&quot;:\&quot;Two Moving Waves Make Still Nodes\&quot;,\&quot;view\&quot;:\&quot;planar\&quot;}&quot;" />
    </WorldInfo>
