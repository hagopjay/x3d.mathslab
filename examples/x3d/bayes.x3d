  <Scene>
    <WorldInfo title="A Positive Signal Changes the Denominator" info="&quot;X3D Math Lab • Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.&quot;">
      <MetadataString containerField="metadata" name="mathlab.sample" reference="mathlab.x3d/1" value="&quot;{\&quot;adapter\&quot;:\&quot;mathlab.x3d/1\&quot;,\&quot;axes\&quot;:\&quot;Left rectangle: all objects, area 24. Right rectangle: positive results only, area 4.8 after conditional rescaling.\&quot;,\&quot;bounds\&quot;:{\&quot;center\&quot;:[-0.75,0.0,0.03125],\&quot;size\&quot;:[9.35,4.5,0.5975]},\&quot;configuration_sha256\&quot;:\&quot;75399bff8bbbfcebc36a90a5d03351a038c2903b0ae068c4a061b4ab4f8d4bd7\&quot;,\&quot;insights\&quot;:[\&quot;Every left-panel cell area divided by 24 is its exact joint probability, including very thin rare-tag cells. The right panel has fixed area 4.8 and is separately normalized to positive results only.\&quot;,\&quot;Mint and amber together form the positive-result denominator. Detection probability P(+|H) and posterior P(H|+) answer different questions.\&quot;,\&quot;Expected counts for 10,000 objects are probability times 10,000. They are not rounded tiles, observed integer counts, or a Monte Carlo result.\&quot;,\&quot;The detector rates are assumed fixed for this population. The model makes no claim that a real detector has constant sensitivity or false-alarm rate across changing populations.\&quot;,\&quot;A likelihood ratio multiplies prior odds, not prior probability. The resulting posterior is a consequence of the stated joint model, not a measure of certainty independent of its assumptions.\&quot;],\&quot;lesson\&quot;:\&quot;bayes\&quot;,\&quot;metrics\&quot;:[{\&quot;id\&quot;:\&quot;posterior\&quot;,\&quot;label\&quot;:\&quot;Tagged among positive results\&quot;,\&quot;note\&quot;:\&quot;This conditional probability is the mint share of the right panel.\&quot;,\&quot;unit\&quot;:\&quot;%\&quot;,\&quot;value\&quot;:50.0},{\&quot;id\&quot;:\&quot;expected_tp\&quot;,\&quot;label\&quot;:\&quot;Expected true positives\&quot;,\&quot;note\&quot;:\&quot;Expected counts may be fractional; no random population was simulated.\&quot;,\&quot;unit\&quot;:\&quot;per 10,000\&quot;,\&quot;value\&quot;:99.00000000000001},{\&quot;id\&quot;:\&quot;expected_fp\&quot;,\&quot;label\&quot;:\&quot;Expected false positives\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;per 10,000\&quot;,\&quot;value\&quot;:99.00000000000001},{\&quot;id\&quot;:\&quot;positive\&quot;,\&quot;label\&quot;:\&quot;All positive results\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;% of all objects\&quot;,\&quot;value\&quot;:1.9800000000000002},{\&quot;id\&quot;:\&quot;likelihood_ratio\&quot;,\&quot;label\&quot;:\&quot;Positive likelihood ratio\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;× prior odds\&quot;,\&quot;value\&quot;:99.0},{\&quot;id\&quot;:\&quot;threshold\&quot;,\&quot;label\&quot;:\&quot;Prior threshold for posterior &gt;50%\&quot;,\&quot;note\&quot;:\&quot;The posterior exceeds one half precisely when the prior exceeds this threshold.\&quot;,\&quot;unit\&quot;:\&quot;%\&quot;,\&quot;value\&quot;:1.0}],\&quot;parameters\&quot;:{\&quot;false_positive\&quot;:0.01,\&quot;prior\&quot;:0.01,\&quot;sensitivity\&quot;:0.99},\&quot;sample_schema\&quot;:\&quot;mathlab.sample/1\&quot;,\&quot;sample_sha256\&quot;:\&quot;2fbe16cf995a670d45767fd95d425add8e74258c413f420099b32284d35ba66d\&quot;,\&quot;scope\&quot;:\&quot;Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.\&quot;,\&quot;title\&quot;:\&quot;A Positive Signal Changes the Denominator\&quot;,\&quot;view\&quot;:\&quot;planar\&quot;}&quot;" />
    </WorldInfo>
