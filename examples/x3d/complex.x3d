    <WorldInfo title="Multiplication Becomes Motion" info="&quot;X3D Math Lab • Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.&quot;">
      <MetadataString containerField="metadata" name="mathlab.sample" reference="mathlab.x3d/1" value="&quot;{\&quot;adapter\&quot;:\&quot;mathlab.x3d/1\&quot;,\&quot;axes\&quot;:\&quot;Horizontal: real part. Vertical: imaginary part. Amber interpolates successive powers along one chosen angle path.\&quot;,\&quot;bounds\&quot;:{\&quot;center\&quot;:[0.0,0.0,0.065],\&quot;size\&quot;:[3.5,3.5,0.76]},\&quot;configuration_sha256\&quot;:\&quot;be24d1386ed4f1edf986b66441a2528f9eab3cca708430f527bd5259db64695d\&quot;,\&quot;insights\&quot;:[\&quot;Violet points solve ζⁿ=1. Amber points are successive powers of the displayed multiplier; only particular modulus/angle choices make the two sets coincide.\&quot;,\&quot;The thin amber curve chooses the unwrapped angle tθ to interpolate between integer powers. It is one chosen continuous interpolation, not a claim about a unique complex logarithm.\&quot;,\&quot;Progress interpolates the multiplier multiplicatively: rᵗ cis(tθ). At t=0 the multiplier is 1; at t=1 it is the chosen target. Angles are in radians.\&quot;],\&quot;lesson\&quot;:\&quot;complex\&quot;,\&quot;metrics\&quot;:[{\&quot;id\&quot;:\&quot;modulus\&quot;,\&quot;label\&quot;:\&quot;Displayed multiplier modulus\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;× per step\&quot;,\&quot;value\&quot;:1},{\&quot;id\&quot;:\&quot;angle\&quot;,\&quot;label\&quot;:\&quot;Displayed angle added\&quot;,\&quot;note\&quot;:\&quot;\&quot;,\&quot;unit\&quot;:\&quot;rad per step\&quot;,\&quot;value\&quot;:1.2566370614359172},{\&quot;id\&quot;:\&quot;endpoint_modulus\&quot;,\&quot;label\&quot;:\&quot;Modulus after n steps\&quot;,\&quot;note\&quot;:\&quot;Compare with r^(tn).\&quot;,\&quot;unit\&quot;:\&quot;\&quot;,\&quot;value\&quot;:1.0},{\&quot;id\&quot;:\&quot;closure\&quot;,\&quot;label\&quot;:\&quot;Distance of zₜⁿ from 1\&quot;,\&quot;note\&quot;:\&quot;Zero indicates closure after n steps, not necessarily n distinct vertices.\&quot;,\&quot;unit\&quot;:\&quot;\&quot;,\&quot;value\&quot;:2.220446049250313e-16},{\&quot;id\&quot;:\&quot;polar_residual\&quot;,\&quot;label\&quot;:\&quot;Cartesian / polar endpoint difference\&quot;,\&quot;note\&quot;:\&quot;Repeated Cartesian products compared with the closed polar formula.\&quot;,\&quot;unit\&quot;:\&quot;\&quot;,\&quot;value\&quot;:2.2884754904439333e-17}],\&quot;parameters\&quot;:{\&quot;angle\&quot;:1.2566370614359172,\&quot;progress\&quot;:1,\&quot;radius\&quot;:1,\&quot;roots\&quot;:5},\&quot;sample_schema\&quot;:\&quot;mathlab.sample/1\&quot;,\&quot;sample_sha256\&quot;:\&quot;2c12f0c73b8698212cd16f40f678420325d9d04e69b29400d3bbef3b72be61f1\&quot;,\&quot;scope\&quot;:\&quot;Static sampled geometry and authored lesson parameters; not a proof, live controller, or checkpoint.\&quot;,\&quot;title\&quot;:\&quot;Multiplication Becomes Motion\&quot;,\&quot;view\&quot;:\&quot;planar\&quot;}&quot;" />
