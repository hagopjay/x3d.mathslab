{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X3D Math Lab parameter card",
  "description": "Known lesson configurations. Missing parameters take catalog defaults. Geometry is regenerated.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "linear"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 1.2,
              "title": "Matrix a"
            },
            "b": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.6,
              "title": "Matrix b"
            },
            "c": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.2,
              "title": "Matrix c"
            },
            "d": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.9,
              "title": "Matrix d"
            },
            "blend": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1,
              "title": "Transformation progress"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
