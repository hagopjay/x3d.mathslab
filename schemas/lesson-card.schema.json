{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X3D Math Lab parameter card",
  "description": "Known lesson configurations. Missing parameters take catalog defaults. Geometry is regenerated.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "linear"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 1.2,
              "title": "Matrix a"
            },
            "b": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.6,
              "title": "Matrix b"
            },
            "c": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.2,
              "title": "Matrix c"
            },
            "d": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.9,
              "title": "Matrix d"
            },
            "blend": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1,
              "title": "Transformation progress"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "derivative"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 0.7,
              "title": "Point x"
            },
            "h": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 1.5,
              "default": 0.6,
              "title": "Step h"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "integral"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "number",
              "minimum": -3,
              "maximum": 0,
              "default": -2,
              "title": "Lower limit a"
            },
            "b": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3,
              "default": 2,
              "title": "Upper limit b"
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 12,
              "title": "Rectangle count"
            },
            "sample": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1,
              "default": 0,
              "title": "Sample: −1 left · 0 midpoint · 1 right"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "fourier"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "terms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 5,
              "title": "Odd harmonics"
            },
            "phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 6.283185307179586,
              "default": 0.9,
              "title": "Phase θ"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "lorenz"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sigma": {
              "type": "number",
              "minimum": 5,
              "maximum": 16,
              "default": 10,
              "title": "σ"
            },
            "rho": {
              "type": "number",
              "minimum": 1,
              "maximum": 40,
              "default": 28,
              "title": "ρ"
            },
            "beta": {
              "type": "number",
              "minimum": 1,
              "maximum": 4,
              "default": 2.6666666666666665,
              "title": "β"
            },
            "dt": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 0.03,
              "default": 0.01,
              "title": "Maximum RK4 step"
            },
            "duration": {
              "type": "number",
              "minimum": 2,
              "maximum": 20,
              "default": 20,
              "title": "Integration duration"
            },
            "separation": {
              "type": "number",
              "minimum": 1e-06,
              "maximum": 0.1,
              "default": 0.001,
              "title": "Initial x separation"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lesson",
        "params"
      ],
      "properties": {
        "schema": {
          "const": "x3d.mathlab.lesson-card/1"
        },
        "lesson": {
          "const": "gradient"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.28,
              "default": 0.15,
              "title": "Learning rate α"
            },
            "condition": {
              "type": "number",
              "minimum": 1,
              "maximum": 20,
              "default": 8,
              "title": "Curvature ratio κ"
            },
            "start_x": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 2.2,
              "title": "Starting x"
            },
            "start_y": {
              "type": "number",
              "minimum": -2.5,
              "maximum": 2.5,
              "default": 1.6,
              "title": "Starting y"
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 28,
              "title": "Descent steps"
            }
          }
        },
        "prediction": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  ]
}
